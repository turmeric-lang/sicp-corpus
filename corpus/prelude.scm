(define-library (corpus prelude)
  (export true false nil runtime random cons-stream the-empty-stream stream-null?)
  (import (scheme base) (scheme time) (srfi 27))
  (begin
    (define true #t)
    (define false #f)
    (define nil '())
    (define (runtime)
      (round (/ (* (current-jiffy) 1000000) (jiffies-per-second))))
    (define (random n)
      (if (exact-integer? n) (random-integer n) (* n (random-real))))
    (define-syntax cons-stream
      (syntax-rules () ((_ a b) (cons a (delay b)))))
    (define the-empty-stream '())
    (define (stream-null? s) (null? s))))
